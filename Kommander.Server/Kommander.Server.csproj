<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Kommander.Server</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
        <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
        <PackageReference Include="CommandLineParser" Version="2.9.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Kommander\Kommander.csproj" />
    </ItemGroup>

    <!-- Startup policy (bind exposure, WAL selection) is decided in internal helpers here rather
         than in Program.cs, because top-level statements cannot be unit tested. Mirrors the same
         attribute in Kommander.csproj. -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Kommander.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
