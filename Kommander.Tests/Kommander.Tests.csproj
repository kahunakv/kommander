<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <NoWarn>$(NoWarn);CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="MartinCostello.Logging.XUnit.v3" Version="0.7.1" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="Xunit.Combinatorial" Version="2.0.24" />
        <PackageReference Include="xunit.v3" Version="2.0.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Kommander\Kommander.csproj" />
      <!-- Kommander.Server is referenced for KommanderServerBindingPolicy: the fail-closed startup
           rules (unauthenticated exposure, mTLS trust anchors, cleartext listener) are security
           policy and must be testable, which top-level statements in Program.cs are not. -->
      <ProjectReference Include="..\Kommander.Server\Kommander.Server.csproj" />
    </ItemGroup>

    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <!-- The random-search seed corpus is read at run time, so it must sit beside the binary. It
           is data rather than code: a seed earns its line by finding something, and the reason is
           written next to it. -->
      <Content Include="Simulation\Scenarios\Random\seed-corpus.txt" Link="seed-corpus.txt" CopyToOutputDirectory="PreserveNewest" />

      <!-- Promoted failures. A generated run that failed leaves its plan under dst-artifacts/;
           copying that file in here turns it into a test that runs for ever. The plan is the
           replay unit rather than the seed, because a seed re-draws against whatever the cluster
           happens to do and a plan does not. -->
      <Content Include="Simulation\Scenarios\Random\regressions\*.plan.txt" LinkBase="regressions" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
